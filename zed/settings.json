// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "proxy": "",
  "edit_predictions": {
    "allow_data_collection": "no"
  },
  "agent": {
    "show_turn_stats": true,
    "auto_compact": {
      "enabled": false
    },
    "sidebar_side": "left",
    "favorite_models": [],
    "model_parameters": []
  },
  "terminal": {
    "bell": "system",
    "font_family": "0xProto Nerd Font",
    "show_count_badge": true
  },
  "project_panel": {
    "auto_open": {
      "on_create": true,
      "on_paste": false,
      "on_drop": false
    },
    "hide_hidden": false,
    "hide_root": true,
    "diagnostic_badges": true,
    "git_status_indicator": true,
    "indent_size": 20.0
  },
  "file_finder": {
    "include_ignored": "all"
  },
  "search": {
    "regex": true
  },
  "colorize_brackets": true,
  "vim": {
    "use_system_clipboard": "never",
    "toggle_relative_line_numbers": false
  },
  "mouse_wheel_zoom": true,
  "horizontal_scroll_margin": 8.0,
  "which_key": {
    "enabled": true
  },
  "unnecessary_code_fade": 0.5,
  "ui_font_weight": 500.0,
  "markdown_preview_code_font_family": "0xProto Nerd Font",
  "markdown_preview_font_family": "0xProto Nerd Font",
  "agent_buffer_font_size": 18.0,
  "agent_ui_font_size": 18.0,
  "ui_font_family": "0xProto Nerd Font",
  "buffer_line_height": "comfortable",
  "buffer_font_weight": 500.0,
  "base_keymap": "VSCode",
  "relative_line_numbers": "enabled",
  "vertical_scroll_margin": 8.0,
  "gutter": {
    "line_numbers": true
  },
  "minimap": {
    "thumb": "hover",
    "show": "never"
  },
  "soft_wrap": "editor_width",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "vim_mode": true,
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "ui_font_size": 20.0,
  "buffer_font_size": 18.0,
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte - No Italics",
    "dark": "Catppuccin Frappé - No Italics",
  },
}
